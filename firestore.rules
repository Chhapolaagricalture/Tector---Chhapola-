rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: check owner_uid field matches auth user
    function isOwnerByField() {
      return isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
    }

    // Helper: owner field cannot be changed on update
    function ownerFieldUnchanged() {
      return !resource.data.diff(resource.dataAfterWrite).affectedKeys()
        .hasAny(['ownerUid', 'owner_uid']);
    }

    // ==========================================
    // RECORDS — owner-isolated
    // ==========================================
    match /records/{recordId} {
      // Read: only owner can read their records
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );

      // Create: must be authenticated, owner field must match auth user
      allow create: if isAuthenticated() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.owner_uid == request.auth.uid
      );

      // Update: only owner, cannot change owner fields, financial values non-negative
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      ) && (
        // Owner field unchanged
        (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['ownerUid', 'owner_uid']))
        // OR owner field still matches auth user
        || request.resource.data.ownerUid == request.auth.uid
        || request.resource.data.owner_uid == request.auth.uid
      );

      // Delete: only owner
      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.owner_uid == request.auth.uid
      );
    }

    // ==========================================
    // USERS — user profile (uid = doc ID)
    // ==========================================
    match /users/{userId} {
      // Read: only own profile (admin reads via backend Admin SDK)
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Write: only own profile
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // USER RATES — per-user work rates
    // ==========================================
    match /user_rates/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // USER PDF SETTINGS — per-user PDF config
    // ==========================================
    match /user_pdf_settings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // FEEDBACK — authenticated users can create, not read
    // ==========================================
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if false;  // Only backend (Admin SDK) reads feedback
      allow update, delete: if false;
    }

    // ==========================================
    // SETTINGS/GLOBAL — read-only for all, write via Admin SDK only
    // ==========================================
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // TRACTOR DETAILS — per-user
    // ==========================================
    match /tractor_details/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // TRACTOR SERVICES — owner-isolated
    // ==========================================
    match /tractor_services/{docId} {
      allow read, write: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    // ==========================================
    // TRACTOR DIESEL — owner-isolated
    // ==========================================
    match /tractor_diesel/{docId} {
      allow read, write: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    // ==========================================
    // TRACTOR REMINDERS — owner-isolated
    // ==========================================
    match /tractor_reminders/{docId} {
      allow read, write: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    // ==========================================
    // BLOCK EVERYTHING ELSE
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
